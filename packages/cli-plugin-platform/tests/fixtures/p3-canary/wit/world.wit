package local:p3-canary@0.1.0;

interface types {
  resource bucket {
    constructor(name: string);
    name: func() -> string;
  }
}

interface compute {
  use types.{bucket};
  open: func(name: string) -> bucket;
  echo: async func(bucket: borrow<bucket>, input: stream<u8>) -> stream<u8>;
  wait: func() -> future<string>;
  cancel: async func(bucket: borrow<bucket>);
}

world application {
  export compute;
}
